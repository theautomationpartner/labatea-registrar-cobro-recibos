# Copiá este archivo a `.env.local` y pegá un token de API de Monday para probar contra la
# cuenta real desde localhost (Monday → Avatar → Developers → My Access Tokens).
# Sin este token, la app usa los datos mock de src/data/mock.ts y funciona igual.
# En producción el token lo inyecta la función serverless (`api/monday.ts`) con MONDAY_TOKEN.
VITE_MONDAY_TOKEN=

# Webhook del escenario de Make que lee los comprobantes (Make → escenario → módulo Webhook → Copiar
# dirección). SIN prefijo VITE_ a propósito: así la dirección se queda del lado del servidor y no
# viaja en el bundle. En desarrollo la usa el proxy de Vite; en producción, `api/make-comprobantes.ts`.
# Hay que cargarla igual en las variables de entorno del deploy.
# Sin esto, la lectura automática del comprobante falla; la carga manual del cobro funciona igual.
MAKE_WEBHOOK_COMPROBANTES=

# ───────────────────────── Capa 2 · autenticación y lista blanca ─────────────────────────
# Todas SIN prefijo VITE_ a propósito: viven en el servidor y no tienen que llegar al bundle.
# Se cargan en Vercel (Project → Settings → Environment Variables). En localhost no hacen falta:
# ahí no hay funciones serverless ni iframe de Monday, y la app pega derecho por el proxy de Vite.
# Ver SEGURIDAD.md para el detalle de cada una.

# EL secreto del session token. Monday lo documenta explícitamente: su ejemplo de verificación es
# `jwt.verify(token, MY_CLIENT_SECRET)`. Sale de monday.com → Developers → tu app → Basic
# Information → "Client Secret". Sin esto cargado, la firma no cierra y TODO da 401 aunque el
# usuario esté bien y habilitado. Es el error más caro de diagnosticar de los tres.
#
# OJO con CUÁL app: el secreto tiene que ser el de `labatea-registrar-cobros-pagos-app`
# (App ID 11865111), NO el de `labatea-alta-de-venta` (App ID 11968092). El token trae su
# `app_id` adentro; si no coincide, la firma nunca va a cerrar por más que el secreto sea válido.
# Ante un 401, el log del servidor dice `token inválido (app NNN)`: ese número es el que tiene que
# coincidir con el App ID del Developer Center.
MONDAY_CLIENT_SECRET=

# Clave de rescate: el "Signing Secret" de la MISMA pantalla. Algunas configuraciones de app firman
# con ésta. El guardián prueba primero el Client Secret y, si no cierra, reintenta con ésta.
# Cargar las dos no cuesta nada y evita un 401 sistémico por haber cargado la que no era.
MONDAY_SIGNING_SECRET=

# Token de API con permiso de LECTURA sobre el tablero de la lista blanca. Puede ser el mismo
# MONDAY_TOKEN que usa el proxy en producción —si no se define, se usa ese—, pero conviene uno
# propio y de solo lectura: así la consulta que decide quién entra no lleva permisos de escritura.
MONDAY_API_TOKEN=

# Tablero PRIVADO donde está la lista de usuarios habilitados (board "Lista Blanca"). Es EL MISMO
# que usa la app de operaciones de venta: quién entra a cada app lo decide la columna "ID APP".
WHITELIST_BOARD_ID=18427866249

# Opcionales: sólo si el tablero se rearma con otras columnas o etiquetas.
# WHITELIST_COLUMN_USER=text_mm6hqsmt      # columna de texto con el User ID de Monday
# WHITELIST_COLUMN_STATUS=status           # columna de estado que habilita o revoca
# WHITELIST_COLUMN_APPS=dropdown_mm6jamkm  # dropdown con los IDs de las apps permitidas
# WHITELIST_STATUS_ACTIVO=Activo           # la etiqueta que habilita; cualquier otra deja afuera

# Con qué ID se identifica ESTA app en la columna de apps de la lista blanca. Por defecto se usa el
# `app_id` que viene FIRMADO en el session token, que no hay que configurar ni se puede falsear.
# Cargar esta variable sólo si se prefiere etiquetar con otra cosa, por ejemplo el Project ID de
# Vercel; en ese caso hay que mantenerla en cada deploy.
# APP_ID=

# Opcional pero recomendado: ata la app a UNA cuenta de Monday. Sin esto, un token firmado por
# Monday para otra cuenta que instale la app también llega al guardián (y ahí lo frena la lista
# blanca, pero es una puerta menos que cerrar). La cuenta de La Batea es 35883216.
# MONDAY_ACCOUNT_ID=35883216

# ───────────────────────── Capa 3 · segundo factor (TOTP) ─────────────────────────
# También del lado del servidor. En localhost no hacen falta: los endpoints de /api/mfa no corren.

# Base de datos donde viven los secretos TOTP, los códigos de recuperación y los dispositivos
# confiables: la MISMA Neon que la app de operaciones de venta ("La Batea Authenticated Users"),
# para que quien ya se enroló allá no tenga que volver a hacerlo acá. La integración de Neon en
# Vercel la inyecta sola al conectar la base al proyecto. Tiene que ser la cadena CON POOLER (el
# host `-pooler`): contra el puerto directo, un pico de tráfico agota las conexiones de la base.
DATABASE_URL=

# Clave de 32 bytes (base64 o hex) con la que se cifran los secretos TOTP y se hashean los códigos
# de recuperación y los tokens de dispositivo.
#
# TIENE QUE SER LA MISMA que la de la app de operaciones de venta, byte por byte. Es lo que hace que
# las dos compartan enrolamientos: con una clave distinta, esta app no puede descifrar el secreto
# que guardó la otra y le pediría a todo el mundo enrolarse de nuevo —pisando el enrolamiento que ya
# tenían—. Copiala de las variables de ese proyecto, no generes una nueva.
MFA_ENCRYPTION_KEY=

# El interruptor de la Capa 3. Con `1` el guardián exige segundo factor en todos los endpoints de
# datos. Dejarlo apagado hasta que la base esté creada y el resto de las variables cargadas:
# encenderlo antes deja a todo el mundo afuera, empezando por quien lo encendió.
# MFA_REQUERIDO=1

# Nombre que muestra Google Authenticator en su lista. Por defecto, "La Batea". Conviene dejarlo
# igual que en la otra app: es el mismo enrolamiento y una sola entrada en el teléfono.
# MFA_EMISOR=La Batea
